# Copia este archivo como .env.local (en local) o pon las variables en Vercel
# (Settings › Environment Variables). Nunca subas los valores reales al repositorio.
# Paso a paso en docs/DESPLIEGUE.md (tabla de variables al final).

# ── Modo demo ────────────────────────────────────────────────────────────────
# 1 = datos de ejemplo en la carpeta .datos, sin Google ni Firebase. Solo en local.
MODO_DEMO=

# ── La ONG ───────────────────────────────────────────────────────────────────
# Dirección pública de la app (para los enlaces de los correos).
APP_URL=https://proyectos.africadirecto.org
# Solo pueden entrar cuentas de Google de este dominio.
ONG_DOMINIO=africadirecto.org
# Correos que serán administradores al entrar por primera vez (separados por comas).
ONG_ADMINS_INICIALES=
# Buzón de la app (ver docs/CORREO.md); los avisos a contrapartes responden a proyectos+CODIGO@...
CORREO_PROYECTOS=proyectos@correo.africadirecto.org

# ── Google Cloud / Firebase (un solo proyecto, a nombre de la cuenta técnica) ─
FIREBASE_PROJECT_ID=
# Cuenta de servicio: Firestore y Drive. La clave privada va entre comillas, con \n.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
# Configuración web de Firebase (es pública, no es secreta).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ── Drive (identificadores de las unidades compartidas) ─────────────────────
DRIVE_UNIDAD_PROYECTOS_ID=
DRIVE_UNIDAD_SISTEMA_ID=
# Opcional: unidad «Plantillas» con plantillas de informe en Google Docs (docs/INFORMES.md).
DRIVE_UNIDAD_PLANTILLAS_ID=
# Solo con delegación de dominio (docs/DRIVE.md, opción 2): usuario en cuyo nombre actúa la app.
GOOGLE_DRIVE_USUARIO=

# ── Secretos (genera cada uno con: openssl rand -base64 32) ─────────────────
# Firma los enlaces de las contrapartes. Si cambia, todos los enlaces dejan de valer.
ENLACES_SECRETO=
# Vercel lo manda al ejecutar el cron diario.
CRON_SECRET=

# ── IA (OpenRouter) ─────────────────────────────────────────────────────────
# Clave de https://openrouter.ai/keys, con límite de gasto en la propia clave.
OPENROUTER_API_KEY=
# Modelos de OpenRouter (https://openrouter.ai/models). Opcionales: sin ellos se usan estos.
IA_MODELO_RAPIDO=anthropic/claude-haiku-5.5
IA_MODELO_REDACCION=google/gemini-3.7-flash

# ── Avisos ──────────────────────────────────────────────────────────────────
# Webhook del espacio de Google Chat de los voluntarios.
GOOGLE_CHAT_WEBHOOK_URL=
